# Backend base URL (BE teammate's server). Can also be changed at runtime in Settings.
EXPO_PUBLIC_API_URL=http://localhost:8000
# 1 = use the in-app mock backend, 0 = call EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK=1
# Active domain pack: agri | health | tourism | <your new pack id>
EXPO_PUBLIC_PACK=health
