# anthropic = real Claude calls; echo = canned replies, no key needed (local dev / smoke tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional tuning
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=on
LLM_TIMEOUT_SECONDS=25
# Pack used for SMS without a "PACKID:" prefix
DEFAULT_PACK=health
LOG_LEVEL=INFO

# Optional trusted joblib bundle; /predict returns 503 until configured and loadable.
# ML_MODEL_PATH=/models/model.joblib

# /extract (text -> structured intake). Defaults to ml/artifacts/experimental_health_ie_final.joblib
# and ml/src in this repo; build the artifact first (see ml/README.md).
# EXTRACT_MODEL_PATH=/models/experimental_health_ie_final.joblib
# EXTRACT_CODE_PATH=/app/ml/src
