{
  "expo": {
    "name": "Njia ya Afya",
    "slug": "nusrangers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nusrangers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "org.nusrangers.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.nusrangers.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show the clinics nearest to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos to reports.",
          "cameraPermission": "Used to take photos for reports."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan patient handoff codes at the clinic."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
